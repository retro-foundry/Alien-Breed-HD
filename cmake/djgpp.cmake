set(CMAKE_SYSTEM_NAME DOS)
set(CMAKE_SYSTEM_PROCESSOR i386)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DJGPP_ROOT)
if(NOT DEFINED DJGPP_ROOT)
  message(FATAL_ERROR "Set DJGPP_ROOT to the DJGPP cross-compiler installation")
endif()
file(TO_CMAKE_PATH "${DJGPP_ROOT}" DJGPP_ROOT)
set(CMAKE_C_COMPILER "${DJGPP_ROOT}/bin/i586-pc-msdosdjgpp-gcc.exe")
set(CMAKE_AR "${DJGPP_ROOT}/bin/i586-pc-msdosdjgpp-ar.exe")
set(CMAKE_RANLIB "${DJGPP_ROOT}/bin/i586-pc-msdosdjgpp-ranlib.exe")
set(CMAKE_C_FLAGS_INIT "-march=i386 -mtune=i486")
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/djgpp-platform.cmake")
