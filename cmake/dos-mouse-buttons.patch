+// INT 33h/05h retains a press/release pair that occurred between pumps.
+// Send at least one edge, then restore the driver's actual held state.
+static void DOSVESA_SendButton(SDL_Mouse *mouse, unsigned index, Uint8 button)
+{
+    __dpmi_regs press = {0};
+    press.x.ax = 0x5;
+    press.x.bx = index;
+    __dpmi_int(0x33, &press);
+    if (press.x.bx != 0) {
+        SDL_SendMouseButton(0, mouse->focus, SDL_DEFAULT_MOUSE_ID, button, false);
+        SDL_SendMouseButton(0, mouse->focus, SDL_DEFAULT_MOUSE_ID, button, true);
+    }
+    SDL_SendMouseButton(0, mouse->focus, SDL_DEFAULT_MOUSE_ID, button, (press.x.ax & (1u << index)) != 0);
+}
