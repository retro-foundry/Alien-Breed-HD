+/* Restore the public RAM surface only when it is read or modified outside
+ * the synchronous canvas loan. Read the displayed page, not the next LFB page.
+ * Banked loans require a readable window; write-only hardware uses the normal
+ * independent system-RAM surface path. No readback is done per gameplay frame. */
+bool Ab3dDos_MaterializeCanvas(SDL_Window *window)
+{
+    if (!fb_state.canvas_surface_stale || fb_state.borrowed_canvas) return true;
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    SDL_VideoData *data = device ? device->internal : NULL;
+    if (!data || !window || !window->surface || !fb_state.direct_fb ||
+        window->surface->pixels != fb_state.pixels || !fb_state.pitches_match)
+        return SDL_SetError("DOS canvas readback state is unavailable");
+    if (fb_state.use_dosmemput) {
+        if (!fb_state.banked_multibank) {
+            dosmemget(fb_state.vram_phys, fb_state.fb_size, fb_state.pixels);
+        } else {
+            Uint32 offset = 0, remaining = fb_state.fb_size;
+            int current_bank = -1;
+            while (remaining) {
+                int bank = (int)(offset / fb_state.win_gran_bytes);
+                Uint32 in_window = offset % fb_state.win_gran_bytes;
+                Uint32 count = SDL_min(remaining, fb_state.win_size_bytes - in_window);
+                SwitchBank(bank, &current_bank, fb_state.win_func_ptr);
+                dosmemget(fb_state.win_base + in_window, count, fb_state.pixels + offset);
+                offset += count;
+                remaining -= count;
+            }
+        }
+    } else {
+        Uint8 *front = fb_state.vram_ptr;
+        if (data->page_flip_available)
+            front = (Uint8 *)DOS_PhysicalToLinear(data->mapping.address) +
+                    data->page_offset[data->current_page];
+        SDL_memcpy(fb_state.pixels, front, fb_state.fb_size);
+    }
+    fb_state.canvas_surface_stale = false;
+    return true;
+}
