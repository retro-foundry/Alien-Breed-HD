 static DOSFramebufferState fb_state;
 
+/* The public window surface borrows the driver's owned system surface. Keep
+ * ownership there while a synchronous native frame uses another RAM canvas. */
+bool Ab3dDos_BeginCanvas(SDL_Window *window, SDL_Surface *source, void **backup)
+{
+    SDL_Surface *target = window ? window->surface : NULL;
+    SDL_VideoDevice *device = SDL_GetVideoDevice();
+    SDL_VideoData *data = device ? device->internal : NULL;
+    const SDL_DisplayModeData *mode = data ? data->current_mode.internal : NULL;
+    if (!mode || !fb_state.pitches_match ||
+        (fb_state.use_dosmemput && !(mode->win_a_attributes & 0x02))) return false;
+    if (!backup || !source || !target || !fb_state.surface || fb_state.borrowed_canvas ||
+        !fb_state.direct_fb || !(fb_state.vram_ptr || fb_state.vram_phys) ||
+        target == fb_state.surface || source->format != SDL_PIXELFORMAT_RGB565 ||
+        target->w != fb_state.vram_w || target->h != fb_state.vram_h ||
+        target->format != source->format || source->w != target->w || source->h != target->h ||
+        source->pitch != fb_state.src_pitch || !source->pixels ||
+        source->locked || target->locked || fb_state.surface->locked ||
+        target->pixels != fb_state.pixels || fb_state.pixels != fb_state.surface->pixels ||
+        source->pixels == fb_state.pixels) return false;
+    *backup = fb_state.pixels;
+    target->pixels = source->pixels;
+    fb_state.pixels = source->pixels;
+    fb_state.borrowed_canvas = true;
+    return true;
+}
+
+void Ab3dDos_EndCanvas(SDL_Window *window)
+{
+    if (!fb_state.borrowed_canvas) return;
+    fb_state.pixels = fb_state.surface->pixels;
+    if (window && window->surface) window->surface->pixels = fb_state.pixels;
+    fb_state.borrowed_canvas = false;
+    fb_state.canvas_surface_stale = true;
+}
+
+void Ab3dDos_DiscardCanvasReadback(void)
+{
+    fb_state.canvas_surface_stale = false;
+}
